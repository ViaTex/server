# Application
APP_NAME=Disasetu-server
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=74955e9d435b4101b8b2fbd32ce61397bb77a0761fc6c700aab6bf8f6bc1e5b1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_I3QcPAnilvr4@ep-silent-shadow-a1dyou38-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# JWT Settings
JWT_SECRET_KEY=e61397bb77a0761fc6c700aab6bf8f6bc1e5b14955e9d435b4101b8b2fbd32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting
RATE_LIMIT_API=10  # requests per second
RATE_LIMIT_LOGIN=5  # requests per minute
RATE_LIMIT_OTP=3  # requests per 5 minutes

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/linkedin/callback

# Email (ZeptoMail)
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=your-zeptomail-username
SMTP_PASSWORD=your-zeptomail-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Disasetu

# SMS Provider (Configure based on your provider)
SMS_PROVIDER=twilio  # or any other provider
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_FROM_NUMBER=+1234567890

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Security
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
ALLOWED_HOSTS=["*"]
COOKIE_SECURE=False  # Set to True in production with HTTPS
COOKIE_SAMESITE=lax  # Use 'strict' in production
COOKIE_DOMAIN=localhost

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
