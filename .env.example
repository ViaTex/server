# Copy to .env and fill in values. Do not commit .env.

# Database (PostgreSQL on same VM)
DATABASE_URL=postgresql://dishasetu_user:YOUR_PASSWORD@localhost:5432/dishasetu

# Security — use a long random string in production
SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS — include frontend and API URLs (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://YOUR_VM_IP:3000","http://YOUR_VM_IP:8000"]

# Optional: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
